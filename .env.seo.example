# DataForSEO credentials. Keep real values in .env.local only.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Alternatively use the ready-made base64 token from DataForSEO API Access.
DATAFORSEO_BASE64=

# Search markets. English defaults to the UK because Go2Thailand uses EUR-oriented
# affiliate copy; override this if the English strategy targets another market.
SEO_NL_LOCATION_NAME=Netherlands
SEO_EN_LOCATION_NAME=United Kingdom

