{
  "name": "go2-thailand",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run data:generate && next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "export": "npm run build && next export",
    "data:cities": "node lib/convert-cities-data.js",
    "data:attractions": "node lib/convert-attractions-data.js",
    "data:food": "node lib/convert-food-data.js",
    "data:enhance-cities": "node lib/enhance-content.js",
    "data:enhance-attractions": "node lib/enhance-attractions.js",
    "data:sitemap": "node lib/sitemap.js",
    "generate:feed": "node lib/generate-feed.js",
    "data:verify": "node lib/verify-data.js",
    "data:index": "node scripts/generate-index-data.js",
    "data:generate": "npm run data:cities && npm run data:attractions && npm run data:food && npm run data:enhance-cities && npm run data:enhance-attractions && npm run data:index && npm run data:sitemap && npm run seo:inventory && npm run generate:feed",
    "data:generate-quick": "npm run data:cities && npm run data:attractions && npm run data:food && npm run data:sitemap && npm run seo:inventory && npm run generate:feed",
    "prebuild": "npm run data:generate",
    "prebuild-quick": "npm run data:generate-quick",
    "convert-data": "npm run data:cities",
    "generate-sitemap": "npm run data:sitemap",
    "enhance": "npm run data:enhance-cities",
    "scrape:cities": "tsx scripts/scrape-cities.ts",
    "scrape:hotels": "tsx scripts/scrape-hotels.ts",
    "scrape:restaurants": "tsx scripts/scrape-restaurants.ts",
    "factcheck:cities": "tsx scripts/factcheck-cities.ts",
    "factcheck:attractions": "tsx scripts/factcheck-attractions.ts",
    "seo:inventory": "tsx scripts/seo-route-inventory.ts",
    "seo:status": "tsx scripts/seo-content-status.ts",
    "seo:cannibalization": "tsx scripts/check-seo-cannibalization.ts",
    "seo:research": "tsx scripts/seo-research.ts",
    "seo:verify": "npm run seo:cannibalization && npm run seo:status",
    "seo:verify:nl-runtime": "tsx scripts/verify-nl-owners.ts",
    "seo:verify:nl-dishes": "tsx scripts/verify-nl-dish-family.ts",
    "seo:verify:nl-visas": "tsx scripts/verify-nl-visa-family.ts",
    "seo:verify:nl-destinations": "tsx scripts/verify-nl-destination-family.ts",
    "seo:verify:nl-attraction-overviews": "tsx scripts/verify-nl-attraction-overviews.ts",
    "seo:verify:nl-weather": "tsx scripts/verify-nl-weather-family.ts",
    "seo:verify:nl-hotel-overviews": "tsx scripts/verify-nl-hotel-overviews.ts",
    "seo:verify:nl-koh-tao": "tsx scripts/verify-nl-koh-tao-family.ts",
    "seo:audit:nl-hotels": "tsx scripts/audit-nl-hotel-family.ts",
    "seo:audit:nl-attractions": "tsx scripts/audit-nl-attraction-family.ts",
    "affiliate:verify": "tsx scripts/verify-amazon-affiliates.ts",
    "design:verify": "tsx scripts/verify-design-system.ts",
    "enhance-full": "node lib/enhance-content.js full",
    "enhance-quick": "node lib/enhance-content.js quick",
    "enhance-stats": "node lib/enhance-content.js stats",
    "enhance-clear": "node lib/enhance-content.js clear",
    "build-enhanced": "npm run data:generate && next build",
    "build-quick": "npm run data:generate-quick && next build",
    "build-production": "npm run data:verify && npm run data:generate && next build && npm run data:verify",
    "deploy-prep": "npm run lint && npm run build-production"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.75.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.95.3",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^2.0.1",
    "convex": "1.42.3",
    "critters": "^0.0.25",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.5.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "lucide-react": "^0.513.0",
    "next": "15.5.21",
    "openai": "^4.103.0",
    "react": "^18",
    "react-dom": "^18",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "resend": "6.18.0",
    "sharp": "0.35.3",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.19.33",
    "@types/react": "18.3.28",
    "@types/react-dom": "^18",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.21",
    "postcss": "8.5.22",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
