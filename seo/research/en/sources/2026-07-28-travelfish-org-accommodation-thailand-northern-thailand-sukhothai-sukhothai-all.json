    "main_topic": [
      {
        "h_title": "Where to stay in Sukhothai",
        "main_title": "Where to stay in Sukhothai",
        "author": null,
        "language": "en",
        "level": 1,
        "primary_content": [
          {
            "text": "A wide range of accommodation is found in both New Sukhothai and Old Sukhothai -- which district you choose depends on the sort of scene that bests suits your tastes. Especially in New Sukhothai, stiff competition has resulted in some of the best-value budget digs found anywhere in Thailand. You’ll also find a growing number of more luxurious options, particularly in Old Sukhothai.",
            "url": "http://www.travelfish.org/accommodation/thailand/northern_thailand/sukhothai/sukhothai/all",
            "urls": [
              {
                "url": "http://www.travelfish.org/accommodation/thailand/northern_thailand/sukhothai/sukhothai/all",
                "anchor_text": "New Sukhothai"
              },
              {
                "url": "http://www.travelfish.org/accommodation/thailand/northern_thailand/sukhothai/sukhothai/all",
                "anchor_text": "Old Sukhothai"
              }
            ]
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
      {
        "h_title": "Our recommended areas of Sukhothai to stay in",
        "main_title": "Where to stay in Sukhothai",
        "author": null,
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "Select which area you’re interested in to browse Travelfish’s recommended hotels, guesthouses, and other places to stay in that area of Sukhothai.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": [
