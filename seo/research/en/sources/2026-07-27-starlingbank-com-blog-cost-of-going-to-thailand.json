              {
                "row_cells": [
                  {
                    "text": "Return flights to Bangkok",
                    "urls": null,
                    "is_header": false
                  },
                  {
                    "text": "£600-£1,000 (depending on time of year)",
                    "urls": null,
                    "is_header": false
                  }
                ]
              },
              {
                "row_cells": [
                  {
                    "text": "Accommodation",
                    "urls": null,
                    "is_header": false
                  },
                  {
                    "text": "£25 pp per night for cheap and cheerful; £50-£70 pp per night for affordable luxury",
                    "urls": null,
                    "is_header": false
                  }
                ]
              },
              {
                "row_cells": [
                  {
                    "text": "Food and drinks",
                    "urls": null,
                    "is_header": false
                  },
                  {
                    "text": "£7 per day at street stalls, markets and 711; £20 per day for restaurants",
                    "urls": null,
                    "is_header": false
                  }
                ]
              },
              {
                "row_cells": [
                  {
                    "text": "Taxis / boat trips",
                    "urls": null,
                    "is_header": false
                  },
                  {
                    "text": "£10 per week on taxis; £30 per week for group boat trips",
                    "urls": null,
                    "is_header": false
                  }
                ]
              },
              {
                "row_cells": [
                  {
                    "text": "Shopping",
                    "urls": null,
                    "is_header": false
                  },
                  {
                    "text": "£20 a week for markets; £100 a week for indy designer clothing and boutique natural skincare products",
                    "urls": null,
                    "is_header": false
                  }
                ]
              },
              {
                "row_cells": [
                  {
                    "text": "Thailand treats (massages, tours etc.)",
                    "urls": null,
                    "is_header": false
                  },
                  {
                    "text": "£40 per week – a 30-minute massage can cost £6",
                    "urls": null,
                    "is_header": false
                  }
                ]
              }
            ],
            "footer": [
              {
                "row_cells": [
                  {
                    "text": "Approx. total for 13 nights",
                    "urls": null,
                    "is_header": true
                  },
                  {
                    "text": "£1,200-£2,200 (depending on how much luxury you go for)",
                    "urls": null,
                    "is_header": true
