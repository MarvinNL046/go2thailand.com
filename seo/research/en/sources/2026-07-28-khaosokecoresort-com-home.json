      {
        "h_title": "Package Stays",
        "main_title": "Package Stays",
        "author": "https://www.facebook.com/ourjunglecamp/",
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "The easiest way to experience Khao Sok and Cheow Lan Lake is with one of our travel packages. Choose which travel style suits you and how long you'd like to stay. All of our packages include room and lake accommodation. Our booking staff can help organise arrival and departure transfers to and from the jungle, ensuring a hassle free escape from start to finish.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": [
          {
