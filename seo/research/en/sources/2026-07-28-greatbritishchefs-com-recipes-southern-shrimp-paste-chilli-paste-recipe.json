          {
            "text": "2 tbsp of shrimp paste",
            "url": null,
            "urls": null
          },
          {
            "text": "1 tbsp of palm sugar",
            "url": null,
            "urls": null
          },
          {
            "text": "lime juice, from 2 regular limes, or at least 4 calamansi limes",
            "url": "https://www.greatbritishchefs.com/collections/lime-recipes",
            "urls": [
              {
                "url": "https://www.greatbritishchefs.com/collections/lime-recipes",
                "anchor_text": "lime juice"
              }
            ]
          },
          {
            "text": "2 tbsp of warm water",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": [
          {
            "text": "1 tsp sea salt",
            "url": "https://www.greatbritishchefs.com/collections/salt-recipes",
            "urls": [
              {
                "url": "https://www.greatbritishchefs.com/collections/salt-recipes",
                "anchor_text": "sea salt"
              }
            ]
          },
          {
            "text": "5 garlic cloves, peeled",
            "url": "https://www.greatbritishchefs.com/collections/garlic-recipes",
            "urls": [
              {
                "url": "https://www.greatbritishchefs.com/collections/garlic-recipes",
                "anchor_text": "garlic cloves"
              }
            ]
          },
          {
            "text": "1/2 coriander root, roughly chopped",
