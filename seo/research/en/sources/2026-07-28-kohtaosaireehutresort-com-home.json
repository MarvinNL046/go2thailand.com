      {
        "h_title": "Free Transfer",
        "main_title": "Sairee Hut Resort Koh Tao",
        "author": null,
        "language": "en",
        "level": 1,
        "primary_content": [
          {
            "text": "For the convenience of our guests, Sairee Hut Resort provides free transfer\nbetween piers and our place. Our friendly driver will be ready to welcome\nyou at the pier on your arrival, give you a safe ride to the resort and send\nyou to the pier right on time after your checking out 2 times a day",
            "url": null,
            "urls": null
          },
          {
            "text": "- First : leave from resort at 8.30 AM.",
            "url": null,
            "urls": null
          },
          {
            "text": "- Second : leave from resort at 1.30 PM.",
            "url": null,
            "urls": null
          },
          {
            "text": "*** All round from pier to resort for any boat just contact our counter NO.\n35",
            "url": null,
            "urls": null
          },
          {
            "text": "It is highly recommended to check your boat timetable before booking your\nflight, train or bus. Beware that the delays of your plane or train are\npossible because of the weather.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
