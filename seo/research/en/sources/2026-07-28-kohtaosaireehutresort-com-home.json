      {
        "h_title": "Sun Sand Sea, Easy & Relax",
        "main_title": "Sairee Hut Resort Koh Tao",
        "author": null,
        "language": "en",
        "level": 3,
        "primary_content": [
          {
            "text": "Sairee Hut Resort Koh Tao is a cozy and friendly place to experience the best of\nKoh Tao. Located on Sairee beach, the longest beach on the west of Koh Tao with\na large beach front swimming pool, modern design rooms and villas in a beautiful\ngarden with state-of-the-art luxury hotel amenity and complete facility as well\nas good food and good services.",
            "url": null,
            "urls": null
          },
          {
            "text": "We Speak Your Language",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
      {
        "h_title": "fulfill your desires with a large variety of accommodation",
        "main_title": "Sairee Hut Resort Koh Tao",
        "author": null,
        "language": "en",
        "level": 3,
        "primary_content": [
          {
            "text": "We understand that one dream destination can be reached by different passions.",
            "url": null,
            "urls": null
          },
          {
            "text": "At Sairee Hut Resort, we respect every need of our customers. We offer a large accommodation\nrange : Deluxe Pool View, Pool Villa View, Deluxe Double Rooms, Grand Superior Room, Family Room,\nVilla Garden View, Superior Rooms and Standard Rooms with family-friendly services.",
            "url": null,
            "urls": null
          },
          {
            "text": "That is the reason you will find Sairee Hut Resort the ideal place to enjoy your holidays in Koh\nTao !",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
