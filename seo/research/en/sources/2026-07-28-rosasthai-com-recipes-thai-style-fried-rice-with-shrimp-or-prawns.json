      {
        "h_title": "Ingredients",
        "main_title": "Thai-style fried rice with shrimp or prawns",
        "author": null,
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "400g (14oz) shrimp or prawns, peeled and deveined",
            "url": null,
            "urls": null
          },
          {
            "text": "2 teaspoons nam pla (Thai fish sauce)",
            "url": null,
            "urls": null
          },
          {
            "text": "Pinch of ground white pepper",
            "url": null,
            "urls": null
          },
          {
            "text": "100g (4oz) button mushrooms, sliced",
            "url": null,
            "urls": null
          },
          {
            "text": "550g (18oz) cooked rice (leftovers are fine)",
            "url": null,
            "urls": null
          },
          {
            "text": "Sliced spring onion, to garnish",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": [
          {
            "text": "4 tablespoons vegetable oil",
            "url": null,
            "urls": null
          },
          {
            "text": "2 teaspoon chopped garlic",
            "url": null,
            "urls": null
          },
          {
            "text": "2 tablespoons soy sauce",
            "url": null,
            "urls": null
          },
          {
            "text": "2 tablespoons oyster sauce",
            "url": null,
            "urls": null
          },
          {
            "text": "2 tablespoons water",
            "url": null,
            "urls": null
          },
          {
            "text": "2 carrots, sliced diagonally",
            "url": null,
            "urls": null
          },
          {
            "text": "1 onion, sliced",
            "url": null,
            "urls": null
          },
          {
            "text": "4 spring onions, sliced",
            "url": null,
            "urls": null
          },
          {
            "text": "Juice of 1 lime",
            "url": null,
            "urls": null
          }
        ],
        "table_content": null
      },
      {
        "h_title": "Method",
        "main_title": "Thai-style fried rice with shrimp or prawns",
        "author": null,
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "Heat the oil in a wok set over a high heat.",
            "url": null,
            "urls": null
          },
          {
            "text": "When smoking hot, add the garlic and stir-fry for a few seconds until fragrant.",
            "url": null,
            "urls": null
          },
          {
            "text": "Next, add the shrimp or prawns. Keep stirring, then pour in the soy sauce, oyster sauce and fish sauce and season with the pepper.",
            "url": null,
            "urls": null
          },
          {
            "text": "Add the carrot, mushrooms, onion and spring onions and stir-fry for another 2 minutes.",
            "url": null,
            "urls": null
          },
          {
            "text": "When everything else is cooked just right, add the cooked rice and stir-fry for 1 last minute, just to heat the rice through.",
            "url": null,
            "urls": null
          },
          {
            "text": "Squeeze over some lime juice and serve immediately, garnished with spring onion slices.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
