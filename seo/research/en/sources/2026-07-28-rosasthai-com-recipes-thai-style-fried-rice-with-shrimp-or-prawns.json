    "main_topic": [
      {
        "h_title": "Thai-style fried rice with shrimp or prawns",
        "main_title": "Thai-style fried rice with shrimp or prawns",
        "author": null,
        "language": "en",
        "level": 1,
        "primary_content": [
          {
            "text": "Fried rice (or khao pad) is basic Thai comfort food – simple but wonderful. In Thailand, you’ll find it in almost every restaurant and at every single food stall with a wok. No matter where you are, this staple dish is always served with a squeeze of lime juice and some young spring onions sprinkled over the top. The trick is to eat a spoonful of rice, quickly followed by a few bits of spring onion to give the palate a subtle kick, ready for your next spoonful. You can get fried rice with vegetables and chicken too, but I like mine with shrimp or prawns.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": [
          {
            "text": "20 mins",
            "url": null,
            "urls": null
          },
