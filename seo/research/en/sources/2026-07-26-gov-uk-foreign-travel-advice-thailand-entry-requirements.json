    "main_topic": [
      {
        "h_title": "Entry requirements",
        "main_title": "Thailand",
        "author": "Foreign, Commonwealth & Development Office",
        "language": "en",
        "level": 1,
        "primary_content": [
          {
            "text": "This information is for people travelling on a full ‘British citizen’ passport from the UK. It is based on the UK government’s understanding of the current rules for the most common types of travel.",
            "url": "https://www.gov.uk/types-of-british-nationality",
            "urls": [
              {
                "url": "https://www.gov.uk/types-of-british-nationality",
                "anchor_text": "‘British citizen’ passport"
              }
            ]
          },
          {
            "text": "The authorities in Thailand set and enforce entry rules. If you’re not sure how these requirements apply to you, contact the Thai Embassy in the UK.",
            "url": "https://london.thaiembassy.org/en/index",
            "urls": [
              {
                "url": "https://london.thaiembassy.org/en/index",
                "anchor_text": "Thai Embassy in the UK"
              }
            ]
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
      {
        "h_title": "Passport validity requirements",
        "main_title": "Thailand",
        "author": "Foreign, Commonwealth & Development Office",
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "To enter Thailand, your passport must have an ‘expiry date’ at least 6 months after the date you arrive and have at least 1 blank page.",
            "url": null,
            "urls": null
          },
          {
            "text": "Check with your travel provider that your passport and other travel documents meet requirements. Renew your passport if you need to.",
            "url": "https://www.gov.uk/renew-adult-passport/renew",
            "urls": [
              {
                "url": "https://www.gov.uk/renew-adult-passport/renew",
                "anchor_text": "Renew your passport"
              }
            ]
          },
          {
            "text": "You will be denied entry if you do not have a valid travel document or try to use a passport that has been reported lost or stolen.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
      {
        "h_title": "Dual nationals",
        "main_title": "Thailand",
        "author": "Foreign, Commonwealth & Development Office",
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "If you’re a dual national, it is best to leave Thailand on the same passport you used to enter – this will avoid problems at immigration.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": [
          {
            "text": "When returning to the UK, British citizens must carry a valid British passport or certificate of entitlement. See Dual citizenship.",
            "url": "https://www.gov.uk/browse/abroad/passports",
            "urls": [
              {
                "url": "https://www.gov.uk/browse/abroad/passports",
                "anchor_text": "British passport"
              },
              {
                "url": "https://www.gov.uk/right-of-abode/apply-for-a-certificate-of-entitlement",
                "anchor_text": "certificate of entitlement"
              },
              {
                "url": "https://www.gov.uk/dual-citizenship",
                "anchor_text": "Dual citizenship"
              }
            ]
          }
        ],
        "table_content": null
      },
      {
        "h_title": "Visa requirements",
        "main_title": "Thailand",
        "author": "Foreign, Commonwealth & Development Office",
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "You can visit Thailand for a period of 60 days for the purpose of tourism, business engagements, and urgent or ad-hoc work. This visa category can be extended for another period not exceeding 30 days.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": [
          {
            "text": "You can also apply in advance for a multiple-entry visa for up to 60 days.",
            "url": "https://london.thaiembassy.org/en/page/tourist-multiple-entries-visa",
            "urls": [
              {
                "url": "https://london.thaiembassy.org/en/page/tourist-multiple-entries-visa",
                "anchor_text": "multiple-entry visa for up to 60 days"
              }
            ]
          },
          {
            "text": "For work, study or other reasons, you need a visa before you travel.",
            "url": "https://www.thaievisa.go.th/",
            "urls": [
              {
                "url": "https://www.thaievisa.go.th/",
                "anchor_text": "visa before you travel"
              }
            ]
          }
        ],
        "table_content": null
      },
      {
        "h_title": "Digital Arrival Card",
        "main_title": "Thailand",
        "author": "Foreign, Commonwealth & Development Office",
        "language": "en",
        "level": 3,
        "primary_content": [
          {
            "text": "From 1 May 2025, all foreign nationals entering Thailand, whether by air, land or sea must complete a digital arrival card online before arrival. Travellers can register for an arrival card within 3 days before they arrive.",
            "url": "https://tdac.immigration.go.th/",
            "urls": [
              {
                "url": "https://tdac.immigration.go.th/",
                "anchor_text": "register for an arrival card"
              }
            ]
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
      {
        "h_title": "Overstaying your visa",
        "main_title": "Thailand",
        "author": "Foreign, Commonwealth & Development Office",
        "language": "en",
        "level": 3,
        "primary_content": [
          {
            "text": "If you overstay the period of your visa, you will get a fine of 500 Thai baht a day up to a maximum of 20,000 baht. You risk being:",
            "url": null,
            "urls": null
          },
          {
            "text": "deported at your own expense",
            "url": null,
            "urls": null
          },
          {
            "text": "banned from re-entering Thailand for up to 10 years",
            "url": null,
            "urls": null
          },
          {
            "text": "Conditions in detention centres can be harsh.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": [
          {
            "text": "held in detention",
            "url": null,
            "urls": null
          }
        ],
        "table_content": null
      },
      {
        "h_title": "Vaccine requirements",
        "main_title": "Thailand",
        "author": "Foreign, Commonwealth & Development Office",
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "To enter Thailand, you must have a certificate to prove you’ve had a yellow fever vaccination if you’re coming from a country listed as a transmission risk.",
            "url": "https://nathnacyfzone.org.uk/factsheet/65/countries-with-risk-of-yellow-fever-transmission",
            "urls": [
              {
                "url": "https://nathnacyfzone.org.uk/factsheet/65/countries-with-risk-of-yellow-fever-transmission",
                "anchor_text": "country listed as a transmission risk"
              }
            ]
          },
          {
            "text": "For full details about medical entry requirements and recommended vaccinations, see TravelHealthPro’s Thailand guide.",
            "url": "https://travelhealthpro.org.uk/country/221/thailand",
            "urls": [
              {
                "url": "https://travelhealthpro.org.uk/country/221/thailand",
                "anchor_text": "TravelHealthPro’s Thailand guide"
              }
            ]
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
      {
        "h_title": "Taking cigarettes into Thailand",
        "main_title": "Thailand",
        "author": "Foreign, Commonwealth & Development Office",
        "language": "en",
        "level": 3,
        "primary_content": [
          {
            "text": "It is illegal to take more than 200 cigarettes per person into Thailand. This is enforced at customs on arrival. If you go over the limit, you could be fined 10 times the value. Your cigarettes will likely be confiscated.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
      }
    ],
