    "main_topic": [
      {
        "h_title": "Jamahkiri Dive Resort & Spa",
        "main_title": "Jamahkiri Dive Resort & Spa",
        "author": null,
        "language": "en",
        "level": 1,
        "primary_content": [
          {
            "text": "Special Luxury Resort in Koh Tao, Thailand",
            "url": null,
            "urls": null
          },
          {
            "text": "Jamahkiri Dive Resort & Spa, is a comfortable and sumptuous living resort located in Thian Og Bay on the south side of Koh Tao, a serenity area of the island, easily reachable by a panoramic 10 minutes drive from the harbour, offering a spectacular view over the gulf of Thailand.",
            "url": null,
            "urls": null
          },
          {
            "text": "Once settled in, you will quickly discover that there are very little reasons to leave the resort, lush tropical garden, cooling pools, the Jamahkiri Spa, a fitness room, the marina and our private diving club, recreational facilities, and fine cuisine, compliment the beauty of the resort’s magnificent surroundings.",
            "url": null,
            "urls": null
          },
          {
            "text": "Our place is the perfect combination for peace, serenity and nature lovers; add to that comfort, natural surrounding, and pristine services and its no wonder that since welcoming his first guest in 2002, Jamahkiri has established its distinctive reputation.",
            "url": null,
            "urls": null
          },
          {
            "text": "Jamahkiri Dive Resort & Spa is a member of the Green Leaf Foundation and Environmental project. Follow the link for more information Click here.",
            "url": "https://www.jamahkiri.com/location/eco-resort/",
            "urls": [
              {
                "url": "https://www.jamahkiri.com/location/eco-resort/",
                "anchor_text": "Click here"
              }
            ]
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
