      {
        "h_title": "Authentic Nam Prik Ong Recipe",
        "main_title": "Authentic Nam Prik Ong Recipe",
        "author": "Praew",
        "language": "en",
        "level": 1,
        "primary_content": [
          {
            "text": "This authentic nam prik ong recipe is a Northern Thai pork and tomato dip made with a fragrant chili paste, juicy tomatoes, and ground pork. It’s one of Chiang Mai’s signature dishes, and after making it many times, I’ve learned exactly how to balance the sweet, tangy, savory, and spicy flavors.",
            "url": null,
            "urls": null
          }
        ],
