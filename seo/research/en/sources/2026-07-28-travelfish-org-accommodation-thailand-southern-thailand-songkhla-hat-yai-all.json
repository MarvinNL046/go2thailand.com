      {
        "h_title": "Our recommended areas of Hat Yai to stay in",
        "main_title": "Where to stay in Hat Yai",
        "author": null,
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "Select which area you’re interested in to browse Travelfish’s recommended hotels, guesthouses, and other places to stay in that area of Hat Yai.",
