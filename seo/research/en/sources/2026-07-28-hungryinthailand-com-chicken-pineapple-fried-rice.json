      {
        "h_title": "Instructions",
        "main_title": "Chicken Pineapple Fried Rice Recipe (Khao Pad Sapparod)",
        "author": "Praew",
        "language": "en",
        "level": 3,
        "primary_content": [
          {
            "text": "Heat oil in a wok or large skillet over medium heat. Add minced garlic and stir until fragrant and golden.",
            "url": null,
            "urls": null
          },
          {
            "text": "Add sliced chicken and stir-fry until it's nearly cooked through, about 80%.",
            "url": null,
            "urls": null
          },
          {
            "text": "Toss in diced carrots and onions. Stir-fry for another minute until slightly softened.",
            "url": null,
            "urls": null
          },
          {
            "text": "Push everything to one side of the wok and crack in the eggs. Let them set slightly, then scramble and mix through the other ingredients.",
            "url": null,
            "urls": null
          },
          {
            "text": "Season with light soy sauce, white sugar, salt, and yellow curry powder. Stir well to coat everything evenly.",
            "url": null,
            "urls": null
          },
          {
            "text": "Add the cooked rice, breaking apart any clumps, and mix until the rice is fully coated in the curry sauce.",
            "url": null,
            "urls": null
          },
          {
            "text": "Gently mix in the pineapple chunks, cashews (if using), and sliced green onions. Toss to combine, and serve hot—bonus points if you serve it in a pineapple shell!",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
      {
