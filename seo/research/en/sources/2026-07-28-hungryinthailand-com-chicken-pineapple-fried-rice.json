          {
            "text": "3.5 oz or 3/4 cup chicken, breast or thighs, thinly sliced",
            "url": null,
            "urls": null
          },
          {
            "text": "1/4 cup carrot, diced",
            "url": null,
            "urls": null
          },
          {
            "text": "1/3 cup onion, diced",
            "url": null,
            "urls": null
          },
          {
            "text": "3 cloves of garlic, minced",
            "url": null,
            "urls": null
          },
          {
            "text": "2 eggs",
            "url": null,
            "urls": null
          },
          {
            "text": "1 teaspoon white sugar",
            "url": null,
            "urls": null
          },
          {
            "text": "1/2 teaspoon salt",
            "url": null,
            "urls": null
          },
          {
            "text": "1/2 tablespoon yellow curry powder",
            "url": null,
            "urls": null
          },
          {
            "text": "2 1/2 cups cooked jasmine rice, preferably day-old chilled rice",
            "url": null,
            "urls": null
          },
          {
            "text": "7 oz or 1 cup sweet fresh pineapple, chunked",
