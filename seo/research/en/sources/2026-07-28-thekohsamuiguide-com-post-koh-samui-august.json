      {
        "h_title": "Is August a good time to visit Koh Samui?",
        "main_title": "We send REALLY USEFUL emails",
        "author": null,
        "language": "en",
        "level": 4,
        "primary_content": [
          {
            "text": "I first visited Koh Samui in August, 2003 and ... clearly, it was a pretty good sales pitch. August is fantastic but – here’s the sneakiest of tips – the island completely empties on September 1st, as families head home for the start of school. If you want August’s fantastic weather, with beaches to yourself, see if you can stretch your trip into the first few days of September.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
