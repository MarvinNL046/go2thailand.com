        "primary_content": [
          {
            "text": "We have eliminated single-use plastic water bottles and provide reusable cups for all guests.",
            "url": null,
            "urls": null
          },
          {
            "text": "Before every dive, our guides educate guests on responsible snorkeling practices (No touching, No standing on coral, No chasing marine life). ​",
            "url": null,
            "urls": null
          },
          {
            "text": "We provide separate bins for recyclables and general waste onboard, ensuring proper disposal and recycling on land.​",
            "url": null,
            "urls": null
          },
          {
            "text": "All food scraps and organic waste are separated and turned into compost, ensuring zero food waste goes to landfill.​",
