      {
        "h_title": "Le Charme Sukhothai – Hotel in Sukhothai Old City, Close to the Historical Park",
        "main_title": "Le Charme Sukhothai Resort\nHotel near Sukhothai Historical Park",
        "author": null,
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "Le Charme Sukhothai Resort is a boutique hotel and resort in Sukhothai Old City, located just 1 km from Sukhothai Historical Park. Designed with Thai village-inspired architecture and surrounded by lotus ponds and tropical gardens, the resort offers a peaceful base for exploring Thailand’s first capital.",
            "url": null,
            "urls": null
          },
          {
            "text": "Wake up close to the ancient temples, enjoy relaxing resort facilities, and return to a quiet garden setting after a day of cultural discovery. Whether you are visiting Sukhothai for heritage travel, a romantic escape, or a family holiday, Le Charme Sukhothai combines local charm with comfortable rooms, dining, pool and warm Thai hospitality.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
