    "main_topic": [
      {
        "h_title": "PINEAPPLE FRIED RICE",
        "main_title": "PINEAPPLE FRIED RICE",
        "author": "Thai Chef School",
        "language": "en",
        "level": 1,
        "primary_content": [
          {
            "text": "INGREDIENTS: 100 g Shrimp",
            "url": null,
            "urls": null
          },
          {
            "text": "1 cup Cooked rice (dry)",
            "url": null,
            "urls": null
          },
          {
            "text": "¼ cup Onion, finely cubed",
            "url": null,
            "urls": null
          },
          {
            "text": "¼ cup Bell pepper, finely diced",
            "url": null,
            "urls": null
          },
          {
            "text": "¼ cup Tomato, seeds removed & diced",
            "url": null,
            "urls": null
          },
          {
            "text": "½ cup Pineapple, cubed",
            "url": null,
            "urls": null
          },
          {
            "text": "¼ cup Raisins",
            "url": null,
            "urls": null
          },
          {
            "text": "¼ cup Cashew nuts",
            "url": null,
            "urls": null
          },
          {
            "text": "3 cloves Garlic, chopped",
            "url": null,
            "urls": null
          },
          {
            "text": "1 stalk Spring onion, finely sliced",
            "url": null,
            "urls": null
          },
          {
            "text": "Phrik Nam Pla",
            "url": null,
            "urls": null
          },
          {
            "text": "2 Tsp Light soy sauce",
            "url": null,
            "urls": null
          },
          {
            "text": "SEASONING SAUCE:",
            "url": null,
            "urls": null
          },
          {
            "text": "1 Tsp Sugar",
            "url": null,
            "urls": null
          },
          {
            "text": "¼ Tsp Salt",
            "url": null,
            "urls": null
          },
          {
            "text": "½ Tsp Turmeric powder",
            "url": null,
            "urls": null
          },
          {
            "text": "2 Tsp Yellow curry powder",
            "url": null,
            "urls": null
          },
          {
            "text": "PREPARATION: 1. Carve out bowl in pineapple halves",
            "url": null,
            "urls": null
          },
          {
            "text": "2. Combine seasoning sauce (light soy sauce, sugar, salt) in small bowl. In separate bowl, combine turmeric and yellow curry powders.",
            "url": null,
            "urls": null
          },
          {
            "text": "4. Shrimp—remove shell and devein. Leave tail on.",
            "url": null,
            "urls": null
          },
          {
            "text": "5. In wok, add 2 Tbsp cooking oil & garlic. Cook until fragrant then add onion, bell pepper, shrimp and cook at least 2 minutes on medium heat.",
            "url": null,
            "urls": null
          },
          {
            "text": "6. Add turmeric and yellow curry powders and rice. Use low heat.",
            "url": null,
            "urls": null
          },
          {
            "text": "7. Add seasoning sauce and mix well.",
            "url": null,
            "urls": null
          },
          {
            "text": "8. Add cashews, raisins, pineapple chunks, and tomato. Cook on low about 2 minutes.",
            "url": null,
            "urls": null
          },
          {
            "text": "9. Add spring onions, cook 30 seconds, turn off heat.",
            "url": null,
            "urls": null
          },
          {
            "text": "10. Plate in pineapple bowl placing shrimp on top.",
            "url": null,
            "urls": null
          },
          {
            "text": "11. Serve with Phrik Nam Pla dip.",
            "url": null,
            "urls": null
          },
          {
            "text": "ADDITIONAL LEARNING: To learn more about our (Traditional & Vegan), click.",
            "url": null,
            "urls": null
          },
