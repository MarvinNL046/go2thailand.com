    "main_topic": [
      {
        "h_title": "5 Must Try Dishes in Chiang Khan, Loei",
        "main_title": "5 Must Try Dishes in Chiang Khan, Loei",
        "author": "THAI.LT",
        "language": "en",
        "level": 1,
        "primary_content": [
          {
            "text": "Chiang Khan is a small city in Loei province located along the Mekong River. It's a Thai tourist top destination for holidays and weekends. You will spot only a few westerners here. We weren’t expecting too much of our visit here but it was a really nice place worth to visit and spend a day or more. You can find a variety of interesting and reasonably priced foods here for trying as well.",
            "url": "https://www.thai.lt/thailand-travel/destinations/northeast-thailand/chiang-khan",
            "urls": [
              {
                "url": "https://www.thai.lt/thailand-travel/destinations/northeast-thailand/chiang-khan",
                "anchor_text": "Chiang Khan"
              }
            ]
          }
        ],
