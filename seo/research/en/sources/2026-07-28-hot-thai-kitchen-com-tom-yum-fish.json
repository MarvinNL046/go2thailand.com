    "main_topic": [
      {
        "h_title": "Tom Yum Fish Soup ต้มยำปลา",
        "main_title": "Tom Yum Fish Soup ต้มยำปลา",
        "author": "Hot Thai Kitchen",
        "language": "en",
        "level": 1,
        "primary_content": [
          {
            "text": "It's rare to find a Thai restaurant that doesn't serve tom yum soup...but it's even more rare to find one that serves tom yum FISH soup! This is a popular variation of tom yum soup in Thailand, which is a country that eats a lot of fish in general, but for some reason I haven't seen it served anywhere in North America. That ocean flavour of the fish broth goes incredibly well with the tart lime juice and all the citrusy herbs that are iconic of tom yum. It's one of the most comforting yet refreshing soups to have any time of year!",
            "url": null,
            "urls": null
          }
        ],
