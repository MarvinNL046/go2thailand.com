      {
        "h_title": "What’s the weather like in Khon Kaen?",
        "main_title": "An independent travel guide to\nKhon Kaen",
        "author": null,
        "language": "en",
        "level": 3,
        "primary_content": [
          {
            "text": "The heart of northeast Thailand, Khon Kaen enjoys hot temperatures year round, with the coolest month of December still quite warm by Thai standards. The wet season is quite moderate as well, peaking in September.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
      {
