    "main_topic": [
      {
        "h_title": "Thailand Healthy Travel Packing List",
        "main_title": "Thailand Healthy Travel Packing List",
        "author": null,
        "language": "en",
        "level": 3,
        "primary_content": [
          {
            "text": "Pack items for your health and safety.",
            "url": null,
            "urls": null
          },
          {
            "text": "You may not be able to purchase and pack all of these items, and some may not be relevant to you and your travel plans. Talk to your doctor about which items are most important for you.",
            "url": null,
            "urls": null
          },
          {
            "text": "This list is general and may not include all the items you need. Check our Traveler Information Center for more information if you are a traveler with specific health needs, such as travelers who are pregnant, immune compromised, or traveling for a specific purpose like humanitarian aid work.",
            "url": "https://wwwnc.cdc.gov/travel/page/traveler-information-center",
            "urls": [
              {
                "url": "https://wwwnc.cdc.gov/travel/page/traveler-information-center",
                "anchor_text": "Traveler Information Center"
              }
            ]
          },
          {
            "text": "Remember to pack extras of important health supplies in case of travel delays.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
      {
