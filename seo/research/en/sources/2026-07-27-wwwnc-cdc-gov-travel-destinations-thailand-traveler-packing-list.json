      {
        "h_title": "Supplies to prevent illness or injury",
        "main_title": "Thailand Healthy Travel Packing List",
        "author": null,
        "language": "en",
        "level": 4,
        "primary_content": [
          {
            "text": "Hand sanitizer or wipes",
            "url": null,
            "urls": null
          },
          {
            "text": "Alcohol-based hand sanitizer containing at least 60% alcohol or antibacterial hand wipes",
            "url": null,
            "urls": null
          },
          {
            "text": "May be needed if camping or visiting remote areas",
            "url": null,
            "urls": null
          },
          {
            "text": "Select an insect repellent based on CDC recommendations: Avoid Bug Bites",
            "url": "http://wwwnc.cdc.gov/travel/page/avoid-bug-bites",
            "urls": [
              {
                "url": "http://wwwnc.cdc.gov/travel/page/avoid-bug-bites",
                "anchor_text": "Avoid Bug Bites"
              }
            ]
          },
          {
            "text": "Permethrin is insect repellent for clothing. It may be needed if you spend a lot of time outdoors. Clothing can also be treated at home in advance.",
            "url": null,
            "urls": null
          },
          {
            "text": "For protection against insect bites while sleeping",
            "url": null,
            "urls": null
          },
          {
            "text": "(SPF 15 or greater) with UVA and UVB protection. See Sun Exposure.",
            "url": "http://wwwnc.cdc.gov/travel/page/sun-exposure",
            "urls": [
              {
                "url": "http://wwwnc.cdc.gov/travel/page/sun-exposure",
                "anchor_text": "Sun Exposure"
              }
            ]
          },
          {
            "text": "Wear for additional sun protection. A wide brim hat is preferred.",
            "url": null,
            "urls": null
          },
          {
            "text": "Examples: child safety seats, bicycle helmets",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": [
