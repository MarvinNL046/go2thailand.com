      {
        "h_title": "– LIVING WITH NATURE –\nThe Greenery Panvaree",
        "main_title": "The Greenery Panvaree",
        "author": null,
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "The Greenery Panvaree located at the breathtaking Cheow Lan Lake in Surat Thani, Thailand, within Khao Sok National Park. Designed with both the interior and exterior crafted from eco-friendly materials, the resort blends harmoniously with the surrounding nature. Every detail has been carefully developed to fulfill the needs of modern travelers who seek peace, privacy, and true relaxation.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
      {
        "h_title": "Everything You Need for the Perfect Getaway\nComfortable Rooms, Delicious Dining, Exciting Activities\n& Exclusive Tour Packages",
        "main_title": "The Greenery Panvaree",
        "author": null,
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "Discover The Greenery Panvaree, an eco-friendly floating resort at Chiew Lan Lake, Surat Thani. Enjoy private floating rooms, a delightful restaurant, exclusive water activities, and all-inclusive tour packages. Experience serenity, comfort, and unforgettable moments in the heart of Khao Sok National Park.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
      {
        "h_title": "Our Accommodations",
        "main_title": "The Greenery Panvaree",
        "author": null,
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "Our floating rooms are private, clean, and comfortable, fully equipped with modern amenities while still embracing the natural charm of the lake.",
            "url": null,
            "urls": null
          },
          {
            "text": "To preserve the exclusivity of each stay, the number of guests is strictly limited to only 30–35 persons per day, ensuring spaciousness, tranquility, and a closer connection with nature.",
