        "h_title": "Wat Plai Laem, Koh Samui",
        "main_title": "Wat Plai Laem, Koh Samui",
        "author": null,
        "language": "en",
        "level": 1,
        "primary_content": [
          {
            "text": "Explore the vibrant beauty of Wat Plai Laem, a unique temple complex in Thailand. Marvel at the striking statues of the smiling Buddha and the 18-armed Buddha by a picturesque pond. Colorful bridges invite you to discover this serene atmosphere and rich cultural heritage—a must-visit for every traveler!",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": [
          {
