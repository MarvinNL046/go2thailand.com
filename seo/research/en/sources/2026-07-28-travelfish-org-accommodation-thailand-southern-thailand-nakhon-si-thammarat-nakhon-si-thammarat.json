    "main_topic": [
      {
        "h_title": "Our recommended areas of Nakhon Si Thammarat to stay in",
        "main_title": "Where to stay in Nakhon Si Thammarat",
        "author": null,
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "Select which area you’re interested in to browse Travelfish’s recommended hotels, guesthouses, and other places to stay in that area of Nakhon Si Thammarat.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": [
          {
            "text": "Nakhon Si Thammarat",
            "url": null,
            "urls": null
