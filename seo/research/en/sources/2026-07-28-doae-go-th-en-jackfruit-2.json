        "h_title": "Scientific name : Artocarpus heterophyllus Lam.",
        "main_title": "Jackfruit",
        "author": null,
        "language": "en",
        "level": 4,
        "primary_content": [
          {
            "text": "The yellow flesh group",
            "url": null,
            "urls": null
          },
          {
            "text": "Shape : ovate or oblong",
            "url": null,
            "urls": null
          },
          {
            "text": "Weight : 7-15 kg",
            "url": null,
            "urls": null
          },
          {
            "text": "Colour : yellowish brown skin; golden yellow flesh",
            "url": null,
            "urls": null
          },
          {
            "text": "Taste : sweet and fragrant Jackfruit of this group are planted widely.",
            "url": null,
            "urls": null
          },
          {
            "text": "The yellowish orange flesh group",
            "url": null,
            "urls": null
          },
          {
            "text": "Colour : yellowish brown skin; yellowish orange flesh",
            "url": null,
            "urls": null
          },
          {
            "text": "Taste : sweet and fragrant",
            "url": null,
            "urls": null
          },
          {
            "text": "Preparation and eating",
            "url": null,
            "urls": null
          },
          {
            "text": "Cut the fruit in half lengthwise.",
            "url": null,
            "urls": null
          },
          {
            "text": "Wipe out all the latex with paper.",
            "url": null,
            "urls": null
          },
          {
            "text": "Remove the core.",
            "url": null,
            "urls": null
          },
          {
            "text": "Place each of the half fruit on a table or a flat surface; press the skin along the edge down with your hands to separate fruit section",
            "url": null,
            "urls": null
          },
          {
            "text": "Pull out each section.",
            "url": null,
            "urls": null
          },
          {
            "text": "Cut open the flesh and remove the seed.",
            "url": null,
            "urls": null
          },
          {
            "text": "Eaten fresh and frozen.",
            "url": null,
            "urls": null
          },
          {
            "text": "Added in fruit salad, ice-cream and desserts.",
            "url": null,
            "urls": null
          },
          {
            "text": "High in protein, calcium, phosphorus, vitamins A and C.",
            "url": null,
            "urls": null
          },
          {
            "text": "2-4 weeks at 12-14 ÌC,",
            "url": null,
            "urls": null
          },
          {
            "text": "85-90% RH",
            "url": null,
            "urls": null
          },
          {
            "text": "Depending on cultivar and maturity stage.",
            "url": null,
            "urls": null
          },
          {
            "text": "The pulp can be refrigerated up to 7 days in closed packaging.",
            "url": null,
            "urls": null
          },
          {
            "text": "Availability : year round",
            "url": null,
            "urls": null
          },
          {
            "text": "Peak period : April-May",
            "url": null,
            "urls": null
          }
        ],
