      {
        "h_title": "Bird Watching in Khao Sok",
        "main_title": "K haosok T ree H ouse",
        "author": null,
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "Khao Sok Tree House offers bird watching tours in Khao Sok National Park. We have various tours and package. Khao Sok Tree House offers also special 'Great Argus' photo tours in Khao Sok.",
            "url": null,
            "urls": null
          },
          {
            "text": "More information about our bird watching tours can be found on our bird watching page. Just click 'continue reading'",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": [
          {
            "text": "Continue Reading »",
            "url": "https://www.khaosoktreehouseresort.com/bird-watching-khaosok.html",
            "urls": [
              {
                "url": "https://www.khaosoktreehouseresort.com/bird-watching-khaosok.html",
