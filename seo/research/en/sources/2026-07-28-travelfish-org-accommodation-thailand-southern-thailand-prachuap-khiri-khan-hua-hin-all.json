    "main_topic": [
      {
        "h_title": "Where to stay in Hua Hin",
        "main_title": "Where to stay in Hua Hin",
        "author": null,
        "language": "en",
        "level": 1,
        "primary_content": [
          {
            "text": "Our favourite part of Hua Hin is found north of the city centre along Naeb Kehardt Road and Soi 51, where some good boutique accommodation fills up with trendy Thais on weekends. In the portion of Central Hua Hin nearest the beach, stacks of cheap guesthouses rub shoulders with upscale chain resorts. Walk 10 minutes away from the sand to find the best selection of budget accommodation. Another cluster of budget options is found on Soi 67 to the south of town, while further south, Khao Takiab Road operates at a lower key.",
            "url": "http://www.travelfish.org/accommodation/thailand/southern_thailand/prachuap_khiri_khan/hua_hin/all",
            "urls": [
              {
                "url": "http://www.travelfish.org/accommodation/thailand/southern_thailand/prachuap_khiri_khan/hua_hin/all",
                "anchor_text": "Naeb Kehardt Road and Soi 51"
              },
              {
                "url": "http://www.travelfish.org/accommodation/thailand/southern_thailand/prachuap_khiri_khan/hua_hin/all",
                "anchor_text": "Central Hua Hin nearest the beach"
              },
              {
                "url": "http://www.travelfish.org/accommodation/thailand/southern_thailand/prachuap_khiri_khan/hua_hin/all",
                "anchor_text": "away from the sand"
              },
              {
                "url": "http://www.travelfish.org/accommodation/thailand/southern_thailand/prachuap_khiri_khan/hua_hin/all",
                "anchor_text": "Soi 67"
              },
              {
                "url": "http://www.travelfish.org/accommodation/thailand/southern_thailand/prachuap_khiri_khan/hua_hin/all",
                "anchor_text": "Khao Takiab Road"
              }
            ]
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
