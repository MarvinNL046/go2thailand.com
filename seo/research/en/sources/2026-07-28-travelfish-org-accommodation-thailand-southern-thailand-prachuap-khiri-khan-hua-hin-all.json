      {
        "h_title": "Far Southern Hua Hin: Khao Takiab Road",
        "main_title": "Where to stay in Hua Hin",
        "author": null,
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "The road to Khao Takiab is Hua Hin’s fastest growing area, with some massive condominiums and big-name hotels having gone up over the past few years. Head past those and you reach a laidback village with some intimate mid- to high-end resorts peppered into residential areas. The beach here is quiet and there’s a decent selection of restaurants. Central Hua Hin is several kilometres away, but songthaews provide regular transport.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
