    "main_topic": [
      {
        "h_title": "Our recommended areas of Surat Thani to stay in",
        "main_title": "Where to stay in Surat Thani",
        "author": null,
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "Select which area you’re interested in to browse Travelfish’s recommended hotels, guesthouses, and other places to stay in that area of Surat Thani.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": [
