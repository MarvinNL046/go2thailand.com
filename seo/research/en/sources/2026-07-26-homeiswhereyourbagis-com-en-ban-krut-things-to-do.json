      {
        "h_title": "Ban Krut Things to Do - 7 Beautiful Places",
        "main_title": "Ban Krut Things to Do - 7 Beautiful Places",
        "author": "Marcel Gorgolewski und Tobias Meyer GbR",
        "language": "en",
        "level": 1,
        "primary_content": [
          {
            "text": "Also available in: Deutsch",
            "url": "https://homeiswhereyourbagis.com/ban-krut-tipps/",
            "urls": [
              {
                "url": "https://homeiswhereyourbagis.com/ban-krut-tipps/",
                "anchor_text": "Deutsch"
              }
            ]
          },
          {
            "text": "Ban Krut is located in the province of Prachuap Khiri Khan, south of Hua Hin and north of Chumphon. While the place is no longer a hidden gem, it is still off the beaten tourist path. Originally, there were many Kaffir lime trees, called Ma Krut in Thai, from which the name Ban (village) Krut comes.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": [
          {
