            "url": null,
            "urls": null
          }
        ],
        "table_content": null
      },
      {
        "h_title": "Sights and Tips for Ban Krut",
        "main_title": "Ban Krut Things to Do - 7 Beautiful Places",
        "author": "Marcel Gorgolewski und Tobias Meyer GbR",
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "Table of Contents",
            "url": null,
            "urls": null
          },
          {
            "text": "Known for its beautiful beach and one of the most beautiful temples in Thailand, we have collected tips for the quiet town of Ban Krut that you can see during your stay. There may not be too much to discover, but if you’re looking for a relaxed, quiet place without much tourism, then you’re in the right place here.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": [
          {
