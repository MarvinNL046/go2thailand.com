    "main_topic": [
      {
        "h_title": "Thailand",
        "main_title": "Weekly Weather Summary",
        "author": null,
        "language": "en",
        "level": 3,
        "primary_content": [
          {
            "text": "The southwest monsoon prevailed over the Andaman Sea, Thailand and the\nGulf of Thailand throughout the period, weakening on 20 Jul. before\nstrengthening in the second half of the period. In\naddition, the low-pressure area covered upper Vietnam almost the period. These\nconditions brought rainfall over Thailand mainly on the first day and in the\nsecond half of the period.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
      {
        "h_title": "Region Weather Summary",
        "main_title": "Weekly Weather Summary",
        "author": null,
        "language": "en",
        "level": 3,
        "primary_content": [
          {
            "text": "Scattered rain in the first half of the period then increasing in rainfall to fairly widespread rain. Heavy rainfall occurred in some areas on 17 , 19 and 23 Jul. Flooding was reported in Chiang Mai province on 22 Jul. Landslides were reported in Nan province on 21 Jul.",
            "url": null,
            "urls": null
          },
          {
            "text": "Scattered to fairly widespread rain on the first day and in the second half of the period while isolated rain during 18-20 Jul. Heavy rainfall occurred in some areas almost the period.",
            "url": null,
            "urls": null
          },
          {
            "text": "Scattered to fairly widespread rain on the first day and at the end of the period with heavy rainfall in some areas at the end of the period while isolated rain in some areas during 18-21 Jul. Gusty wind was reported in Saraburi and Lop Buri provinces on 17 Jul.",
            "url": null,
            "urls": null
          },
          {
            "text": "Fairly widespread rain on the first day and at the end of the period with heavy to very heavy rainfall while isolated to scattered during 18-21 Jul.",
            "url": null,
            "urls": null
          },
          {
            "text": "Scattered rain at the beginning and on the last day of the period with heavy rainfall in some areas and very heavy rainfall in some areas on 17 Jul. while isolated rain during 19-22 Jul.",
            "url": null,
            "urls": null
          },
          {
            "text": "Scattered to fairly widespread rain on the first day and at the end of the period with heavy rainfall in some areas on 23 Jul. while isolated rain during 18-20 Jul.",
            "url": null,
            "urls": null
          },
          {
            "text": "Scattered to fairly widespread rain on the first day and at the end of the period with heavy rainfall in some areas at the end of the period. Rainfall hardly reported during 18-20 Jul.",
            "url": null,
            "urls": null
          },
          {
            "text": "Content on this page",
            "url": null,
            "urls": null
          }
        ],
