    "main_topic": [
      {
        "h_title": "Moo Palo (Thai Pork Belly Stew with Eggs)",
        "main_title": "Moo Palo (Thai Pork Belly Stew with Eggs)",
        "author": null,
        "language": "en",
        "level": 1,
        "primary_content": [
          {
            "text": "Fragrant with star anise, a five-spice powder and cinnamon, this stewed pork dish is famous in Thailand. “Moo” means pig and “kai” means egg. Cilantro roots are also made the most of for the stewing liquid.",
            "url": null,
            "urls": null
          },
          {
            "text": "Nutrition facts are for one serving.",
            "url": null,
            "urls": null
          },
          {
            "text": "Nutritional values calculated for 4 servings.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": [
          {
            "text": "Southeast Asian",
            "url": "https://www.kikkoman.com/en/cookbook/search/search.html?features[]=3_12",
            "urls": [
              {
                "url": "https://www.kikkoman.com/en/cookbook/search/search.html?features[]=3_12",
                "anchor_text": "Southeast Asian"
              }
            ]
          }
        ],
        "table_content": null
      },
      {
        "h_title": "Directions",
        "main_title": "Moo Palo (Thai Pork Belly Stew with Eggs)",
        "author": "Yurico Aoki",
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "Use a mortar and pestle or a food processor to prepare a paste from the cilantro roots, garlic and white pepper.",
            "url": null,
            "urls": null
          },
          {
            "text": "Heat the cooking oil over medium in a pot, add in (1) and saute until fragrant. Add and mix in the soy sauce and palm sugar, then add in the pork belly and coat with the stewing liquids while browning all surfaces.",
            "url": null,
            "urls": null
          },
          {
            "text": "Add the water to (2), bring to a boil and remove any scum that forms. Add in the cinnamon sticks, star anise, five-spice powder and boiled eggs, then allow to simmer for about 40 to 45 minutes. After tasting, add soy sauce and palm sugar (both extra) to adjust the flavor if necessary.",
            "url": null,
            "urls": null
          },
          {
            "text": "Remove the boiled eggs and cut in half lengthwise. Arrange the pork in bowls, ladle on the stewing liquids and garnish with the cilantro leaves.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
      {
        "h_title": "Cooking Basics",
        "main_title": "Moo Palo (Thai Pork Belly Stew with Eggs)",
        "author": "Yurico Aoki",
        "language": "en",
        "level": 3,
        "primary_content": [
          {
            "text": "Remove the eggs from a refrigerator about 30 minutes prior to return to room temperature. Place a small amount of salt into boiled water, then add in the eggs. Using a ladle to gently add in the eggs can help prevent cracking. Once the desired boiling time has passed, remove the eggs into cold water and allow to cool completely.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": [
          {
            "text": "Eggs - boiling",
            "url": null,
            "urls": null
          }
        ],
        "table_content": null
      },
      {
