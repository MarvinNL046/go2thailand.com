      {
        "h_title": "Thai Fried Mussels Recipe (Hoi Tod)",
        "main_title": "Thai Fried Mussels Recipe (Hoi Tod)",
        "author": "Praew",
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "This is a quick and easy Thai fried mussels recipe, also known as hoi tod. Made with a crispy egg batter, bean sprouts, and simple Thai seasonings.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
      {
        "h_title": "Ingredients",
        "main_title": "Thai Fried Mussels Recipe (Hoi Tod)",
        "author": "Praew",
        "language": "en",
        "level": 3,
        "primary_content": [
          {
            "text": "3 tbsp or 25 g tapioca starch",
