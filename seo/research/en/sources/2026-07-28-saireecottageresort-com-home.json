      {
        "h_title": "Genuine Island Hospitality at Sairee Beach",
        "main_title": "Coming Soon",
        "author": null,
        "language": "en",
        "level": 1,
        "primary_content": [
          {
            "text": "Sairee Cottage Resort is locally owned and located in the heart of Sairee Beach, Koh Tao’s most vibrant area. Restaurants, dive centers, nightlife, and boat trips to the iconic Koh Nang Yuan are all just steps away.",
            "url": null,
            "urls": null
          },
          {
            "text": "We offer a range of accommodations, from traditional fan bungalows to beachfront rooms, suitable for solo travelers, couples, families, and friends. Our beachfront location is ideal for enjoying Koh Tao’s famous sunsets while staying close to everything the island has to offer.",
            "url": null,
            "urls": null
          },
          {
            "text": "Whether you’re here to dive, explore, or simply unwind, we look forward to welcoming you and helping you feel at home.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
