      {
        "h_title": "Thai Food",
        "main_title": "Thailand Foundation",
        "author": "Thailand Foundation",
        "language": "en",
        "level": 1,
        "primary_content": null,
        "secondary_content": [
          {
            "text": "Thai food is a symphony of senses and flavors. As a land of plenty, Thailand has inherited a cuisine rich in culture and variety. Local essences blend seamlessly with global flavors through trade and migration. The results of which are dishes steeped in diversity, from the royal dining hall to family tables. With the emergence of modern lifestyle, Thai culinary tradition has also transitioned into the realm of street cuisine without losing the spirit of detailed finesse. As such, Thailand is considered to be a leading figure in street food and modern dining culture. Today, Thai food is known far and wide, with generations of cooks continuing to preserve and built upon the Thai culinary heritage.",
            "url": null,
            "urls": null
          }
        ],
        "table_content": null
