      {
        "h_title": "Tips for Visitors",
        "main_title": "Wat Phra Chetuphon Wimon Mangkhalaram Rajwaramahawihan",
        "author": null,
        "language": "en",
        "level": 2,
        "primary_content": [
          {
            "text": "Once entering the precincts of any temple please keep calm and be polite since the temple is a sacred place where religious rites and activities are performed.",
            "url": null,
            "urls": null
          },
          {
            "text": "Traditional or polite dress is required, while shorts above the knees are prohibited for woman. It is required to take off your shoes and put them on the shelf before entering religious buildings. Women are also prohibited from all areas set aside for monks to perform their rites.",
            "url": null,
            "urls": null
          },
          {
            "text": "The Buddha image is respected by all Buddhists. In temples and ancient monuments, photos can be taken, but never step on the image. Only permitted officer is allowed to climb up the image to clean and place the offerings.",
            "url": null,
            "urls": null
          },
          {
            "text": "For monks, visitors are asked to be polite and gentle in both manners and words since monks are representatives for the Lord Buddha. Practically, monks and men can touch physically, but it is prohibited for women to have a physical contact with monks or novices.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
      }
