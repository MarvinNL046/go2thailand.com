      {
        "h_title": "Khao Sok Lake® is the only operator with direct access to all 14 floating bungalows on Cheow Lan Lake. We will always place you in a raft house of equal or greater quality to the one you select.",
        "main_title": "Floating Bungalows, Khao Sok Lake",
        "author": "Khao Sok Lake L.T.D.",
        "language": "en",
        "level": 3,
        "primary_content": [
          {
            "text": "DISCLAIMER: All bookings are subject to availability. Conditions on Khao Sok Lake vary from week to week. Khao Sok Lake® does not guarantee a specific raft house, but we will always place you in one of equal or greater quality.",
            "url": null,
            "urls": null
          },
