    "main_topic": [
      {
        "h_title": "Bangkok, 15 December 2023 – Starting from today, the Thai government officially allows entertainment venues in some tourist areas in Bangkok, Phuket, Chon Buri, Chiang Mai, Surat Thani’s Ko Samui, as well as in legally-registered hotels nationwide to extend opening hours until 4 am.",
        "main_title": "Entertainment venues in Thai tourist destinations to open until 4 am",
        "author": "TAT Newsroom",
        "language": "en",
        "level": 3,
        "primary_content": [
          {
            "text": "Only on New Year’s Eve that pubs and bars in all locations across the country are allowed to stay open until 6 am of New Year’s Day.",
            "url": null,
            "urls": null
          },
          {
            "text": "Entertainment venues must have a licence to operate, and likewise for hotel properties.",
            "url": null,
            "urls": null
          },
          {
            "text": "Authorities have been instructed to ensure public safety and to come down harder on those violating the laws on noise problem, drunk driving, and drug abuse.",
            "url": null,
            "urls": null
          },
          {
            "text": "Published in the Royal Thai Government Gazette on 15 December 2023, the Minister of Interior’s regulation followed the Cabinet’s decision to promote tourism and stimulate the economy.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
      {
        "h_title": "TAT Newsroom",
