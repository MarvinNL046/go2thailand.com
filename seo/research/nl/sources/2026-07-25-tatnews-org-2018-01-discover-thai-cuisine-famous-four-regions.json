        "primary_content": null,
        "secondary_content": [
          {
            "text": "“Trusted Thailand” Is Rewriting the Rules of Travel Safety",
            "url": "https://www.tatnews.org/2026/07/trusted-thailand-is-rewriting-the-rules-of-travel-safety/",
