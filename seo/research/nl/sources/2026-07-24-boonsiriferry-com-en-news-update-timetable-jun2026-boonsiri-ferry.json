        "h_title": "Inter-Island & Inbound Routes",
        "main_title": "2026 Travel Guide: Boonsiri Ferry Schedules, Routes, and Pricing (Gulf of Thailand & Eastern Coast)",
        "author": null,
        "language": "en",
        "level": 3,
        "primary_content": [
          {
            "text": "Koh Samui (Lipa Noi Pier) → Koh Phangan → Koh Tao: Departs daily at 02:10 PM (Arrives Koh Phangan at 02:45 PM / Koh Tao at 04:15 PM). *A highly popular afternoon corridor optimized for travelers staying on Samui’s west coast.*",
            "url": null,
            "urls": null
          },
          {
            "text": "Koh Tao → Bangkok (Khao San Road): The primary inbound service departs Koh Tao at 10:00 AM, connecting to the mainland VIP bus directly into Bangkok.",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": null,
        "table_content": null
      },
