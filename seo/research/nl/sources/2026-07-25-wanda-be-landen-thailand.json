              },
              {
                "url": "https://www.wanda.be/a-z-index/leishmaniase",
                "anchor_text": "leishmaniase"
              }
            ]
          },
          {
            "text": "Bescherm u tegen insecten.",
            "url": "https://www.wanda.be/nl/a-z-index/muggenwerende-maatregelen",
