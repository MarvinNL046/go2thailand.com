      },
      {
        "h_title": "Andere insectenoverdraagbare ziekten",
        "main_title": "Thailand",
        "author": null,
        "language": "nl",
        "level": 3,
        "primary_content": [
          {
            "text": "Japanse encefalitis komt sporadisch voor in heel het land gedurende heel het jaar. Het piekseizoen is tussen mei en oktober en vooral in het noorden.",
            "url": "https://www.wanda.be/a-z-index/japanse-encefalitis",
            "urls": [
              {
                "url": "https://www.wanda.be/a-z-index/japanse-encefalitis",
                "anchor_text": "Japanse encefalitis"
              }
            ]
          }
        ],
        "secondary_content": [
          {
            "text": "Insecten kunnen ziekten overdragen zoals dengue, chikungunya, zika en leishmaniase.",
            "url": "https://www.wanda.be/nl/a-z-index/dengue/",
            "urls": [
              {
                "url": "https://www.wanda.be/nl/a-z-index/dengue/",
