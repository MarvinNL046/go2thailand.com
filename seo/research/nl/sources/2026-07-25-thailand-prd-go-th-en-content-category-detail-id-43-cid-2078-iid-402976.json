  "page_content": {
    "header": {
      "primary_content": [
        {
          "text": "Thailand's Royal Gazette has published a new announcement from the Prime Minister’s Office, officially easing alcohol sale restrictions under the Alcohol Beverage Control Act.",
          "url": null,
          "urls": null
        },
        {
          "text": "Effective 27 June 2025, alcohol can now be sold 24 hours a day in three specific locations:",
          "url": null,
          "urls": null
        },
        {
          "text": "Passenger service areas inside international airports",
          "url": null,
          "urls": null
        },
        {
          "text": "Entertainment venues licensed under the Entertainment Act",
          "url": null,
          "urls": null
        },
        {
          "text": "Hotels registered under the Hotel Act",
          "url": null,
          "urls": null
        },
        {
          "text": "Signed by Prime Minister Paetongtarn Shinawatra and based on recommendations from the National Alcohol Policy Committee, the new regulation replaces the 2015 rules to better align with today’s economic and social landscape—particularly in support of tourism and the service sector.",
          "url": null,
          "urls": null
        },
        {
          "text": "Beyond the newly exempted venues, alcohol sales remain restricted to 11:00–14:00 and 17:00–24:00 daily.",
          "url": null,
          "urls": null
        }
      ],
