    "main_topic": [
      {
        "h_title": "‘Unpredictable and extreme’: Asia braces for El Niño",
        "main_title": "‘Unpredictable and extreme’: Asia braces for El Niño",
        "author": "https://www.facebook.com/theguardian",
        "language": "en",
        "level": 1,
        "primary_content": [
          {
            "text": "This article is more than 1 month old",
            "url": null,
            "urls": null
          },
          {
            "text": "Weather models project a potentially strong El Niño this year, which could spell disaster for heatwave-hit India, drench China and hurt agriculture across south-east Asia",
            "url": null,
            "urls": null
          },
          {
            "text": "The UN has warned that the world must prepare for the imminent return of El Niño and the raised global temperatures and weather extremes it brings.",
            "url": "https://www.theguardian.com/environment/2026/jun/02/prepare-for-imminent-return-of-el-nino-un-warns",
            "urls": [
              {
                "url": "https://www.theguardian.com/environment/2026/jun/02/prepare-for-imminent-return-of-el-nino-un-warns",
                "anchor_text": "warned"
              }
            ]
          },
          {
            "text": "The powerful natural weather pattern has an 80% chance of forming before September and a 90% chance before November, the World Meteorological Organization (WMO) said on Tuesday.",
            "url": null,
            "urls": null
          },
          {
            "text": "Experts say what is particularly concerning is that El Niño is unfolding against the backdrop of human-driven climate change, meaning there is the potential for its impacts to be supercharged.",
            "url": null,
            "urls": null
          },
          {
            "text": "Asia is predicted to be one of the regions most exposed, with intensifying heat and drought predicted to put major stresses on agriculture, power grids and water supplies.",
            "url": null,
            "urls": null
          },
          {
            "text": "Here’s how conditions look in key areas across the continent:",
            "url": null,
            "urls": null
          }
        ],
        "secondary_content": [
          {
            "text": "World almost certain to endure record hot year by 2030, UN warns",
            "url": "https://www.theguardian.com/environment/2026/may/28/climate-impacts-spiralling-more-record-global-heat-warns-un",
            "urls": [
              {
                "url": "https://www.theguardian.com/environment/2026/may/28/climate-impacts-spiralling-more-record-global-heat-warns-un",
                "anchor_text": "World almost certain to endure record hot year by 2030, UN warns"
              }
            ]
          },
          {
            "text": "Read more",
            "url": "https://www.theguardian.com/environment/2026/may/28/climate-impacts-spiralling-more-record-global-heat-warns-un",
            "urls": [
              {
                "url": "https://www.theguardian.com/environment/2026/may/28/climate-impacts-spiralling-more-record-global-heat-warns-un",
                "anchor_text": "Read more"
              }
