    "main_topic": [
      {
        "h_title": "Non-Immigrant Visa O-A (long stay)",
        "main_title": "Non-Immigrant Visa O-A (long stay)",
        "author": null,
        "language": "th",
        "level": 2,
        "primary_content": [
          {
            "text": "NON-IMMIGRANT VISA Category “O-A” (Long Stay)",
            "url": null,
            "urls": null
          },
          {
            "text": "This type of visa may be issued to applicants aged 50 years or over who wish to stay in Thailand for a period NOT exceeding 1 year without the intention of working. Holder of this type of visa is allowed to stay in Thailand for 1 year. Employment of any kind is strictly prohibited.",
            "url": null,
            "urls": null
          },
          {
            "text": "1.1 Applicant must be at least 50 years of age (on the day of submitting application).",
            "url": null,
            "urls": null
          },
          {
            "text": "1.2 Applicant is not prohibited from entering the Kingdom as provided by the Immigration Act B.E. 2522 (1979).",
            "url": null,
            "urls": null
          },
          {
            "text": "1.3 Applicant must have no criminal record in Thailand and the country of the applicant’s nationality or residence.",
            "url": null,
            "urls": null
          },
          {
            "text": "1.4 Applicant must have the nationality of or permanent residence in the country where application is submitted",
            "url": null,
            "urls": null
          },
          {
            "text": "1.5 Applicant must NOT have prohibitive diseases (Leprosy, Tuberculosis, drug addiction, Elephantiasis, third phase of Syphilis) as indicated in the Ministerial Regulation No. 14 B.E. 2535",
            "url": null,
            "urls": null
          },
          {
            "text": "1.6 Applicant must have a health insurance covering the length of stay in Thailand with no less than 100,000 USD or 3,000,000 THB for overall medical coverage. (must be specifically mentioned) Apllicant may consider buying a Thai health insurance online at longstay.tgia.org.",
            "url": "https://longstay.tgia.org/",
            "urls": [
              {
                "url": "https://longstay.tgia.org/",
                "anchor_text": "longstay.tgia.org"
              }
            ]
          },
          {
            "text": "1.7 Applicant is prohibited from engaging in any gainful employment in Thailand.",
            "url": null,
            "urls": null
          },
          {
            "text": "Passport with validity of not less than 18 months",
            "url": null,
            "urls": null
          },
          {
            "text": "passport-sized photo (3.5 x 4.5 cm) of the applicant taken within the past six months",
            "url": null,
            "urls": null
          },
          {
            "text": "Confirmed ticket paid in full",
            "url": null,
            "urls": null
          },
          {
            "text": "A copy of bank statement showing a deposit of the amount in local currency or in THB no less than 800,000 THB; OR",
            "url": null,
            "urls": null
          },
          {
            "text": "An income certificate (an original copy) for the past 3 months with a monthly income no less than 65,000 THB; OR",
            "url": null,
            "urls": null
          },
          {
            "text": "A copy of bank statement showing a deposit account together with an annual income totalling no less than 800,000 THB.",
            "url": null,
            "urls": null
          },
          {
            "text": "An English Extract from the birth registration (verification shall be valid for not more than three months and must be legalised by MinBuZa - Ministerie van Buitenlandse Zaken and the Embassy )",
